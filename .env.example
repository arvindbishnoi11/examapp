# =============================================================================
# PrepSetu — local development environment (copy to `.env` for the frontend build)
# =============================================================================
# EVERYTHING IN THIS FILE IS PUBLIC. It is compiled into the browser bundle.
# Never put a private key, API secret or service-account credential here.
# Server secrets live in Cloudflare Secrets / `.dev.vars` (see bottom of file).
# =============================================================================

# ---- App -------------------------------------------------------------------
VITE_APP_NAME=PrepSetu
VITE_APP_ENV=development

# ---- Firebase Web SDK (public client config) -------------------------------
# Firebase web API keys are NOT secrets (they identify the project, they do not
# authorise anything). Real protection comes from Firebase Security Rules,
# App Check and server-side ID-token verification.
VITE_FIREBASE_API_KEY=AIzaSyDPyVTOFVe0i974ZD0QduaNme5qHcxdgmY
VITE_FIREBASE_AUTH_DOMAIN=rankup29.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rankup29
VITE_FIREBASE_STORAGE_BUCKET=rankup29.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=442796432366
VITE_FIREBASE_APP_ID=1:442796432366:web:a19136f23c43bc29304cff
VITE_FIREBASE_MEASUREMENT_ID=G-Q2CEWQ85YQ

# ---- Firebase Cloud Messaging (public VAPID key) ---------------------------
# Firebase console -> Project settings -> Cloud Messaging -> Web Push
# certificates -> "Generate key pair". Public key only.
VITE_FIREBASE_VAPID_KEY=

# ---- Google Sheets (public spreadsheet id used by the admin sync UI) -------
VITE_GOOGLE_SHEET_ID=1tNqp66KgAnnhCRceOPkZubl1C-pMK_olzJkBlKGEnE4
VITE_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1tNqp66KgAnnhCRceOPkZubl1C-pMK_olzJkBlKGEnE4/edit

# ---- Super admin (public email; the backend independently verifies) --------
# The *authority* for this value is the SUPER_ADMIN_EMAIL secret on the Worker.
VITE_SUPER_ADMIN_EMAIL=arvindbishnoi@gmail.com

# ---- Firebase App Check reCAPTCHA v3 site key (public) ---------------------
VITE_RECAPTCHA_SITE_KEY=

# ---- Optional: local emulator plumbing (development only) ------------------
VITE_AUTH_EMULATOR_URL=
VITE_USE_FIREBASE_EMULATORS=false

# ---- Firebase App Check debug token (development only) ---------------------
# Never set this in production: App Check debug tokens bypass attestation.
VITE_APP_CHECK_DEBUG_TOKEN=


# =============================================================================
# SERVER SECRETS — NOT read by Vite. Set these with `wrangler secret put <NAME>`
# (production) or in `.dev.vars` (local, git-ignored). See .dev.vars.example.
# =============================================================================
# GOOGLE_SERVICE_ACCOUNT_JSON   {"type":"service_account", ...}  (single line)
# YOUTUBE_API_KEY               YouTube Data API v3 key
# FIREBASE_SERVICE_ACCOUNT_JSON {
#                               "type":"service_account"|"authorized_user",
#                               "project_id":"rankup29",
#                               "private_key":"-----BEGIN PRIVATE KEY-----\n...",
#                               "client_email":"firebase-adminsdk-...@rankup29.iam.gserviceaccount.com"
#                               }   (verify ID tokens + FCM v1; needs role
#                               "Firebase Admin SDK Administrator Service Agent")
# FIREBASE_PROJECT_ID           rankup29 (required with FIREBASE_SERVICE_ACCOUNT_JSON)
# SUPER_ADMIN_EMAIL             arvindbishnoi@gmail.com
# ADMIN_SESSION_SECRET          >= 32 random bytes, HMAC for short-lived API
#                               exchange tokens used when FCM/Admin SDK is not
#                               configured (see docs/AUTH.md)
# IP_HASH_SECRET                >= 16 random bytes, salt for privacy-preserving
#                               rate-limit keys
# ALLOWED_ORIGINS               https://prepsetu.pages.dev,http://localhost:5173
